APP_NAME=Payroll OS Backend
APP_ENV=production
DATABASE_URL=postgresql+psycopg2://payroll_user:replace_me@postgres-host:5432/payroll_os
CORS_ORIGINS=https://your-easypanel-domain.example
FRONTEND_URL=https://your-easypanel-domain.example
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_TIMEOUT_SECONDS=30
DB_STARTUP_RETRIES=30
DB_STARTUP_RETRY_SECONDS=2
JWT_SECRET_KEY=replace-with-a-random-64-character-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_BCRYPT_ROUNDS=12
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_NAME=Admin User
UPLOAD_PATH=/app/backend/uploads
UPLOAD_URL_PATH=/uploads
MAX_LOGO_UPLOAD_BYTES=2097152
